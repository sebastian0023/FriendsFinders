        <mxCell id="label_github" value="&lt;b style=&quot;font-size: 12px; color: #232F3E;&quot;&gt;GitHub Actions CI/CD&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;.github/workflows/deploy.yml&lt;br/&gt;&amp;bull; npm ci &amp;amp; esbuild bundles&lt;br/&gt;&amp;bull; terraform init &amp;amp; apply&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;color: #16A34A; font-size: 10px;&quot;&gt;💰 $0.00 (2,000 Free mins)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="10" y="995" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- AWS IAM OIDC Role -->
        <mxCell id="icon_iam_role" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#CC2264;strokeColor=#ffffff;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="930" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="label_iam_role" value="&lt;b style=&quot;font-size: 12px; color: #232F3E;&quot;&gt;AWS IAM OIDC Role&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;Short-lived STS Token&lt;br/&gt;Zero static credentials stored!&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;color: #16A34A; font-size: 10px;&quot;&gt;💰 $0.00 (IAM is Free)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="270" y="995" width="180" height="65" as="geometry"/>
