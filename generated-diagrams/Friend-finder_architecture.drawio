          <mxGeometry x="540" y="995" width="180" height="65" as="geometry"/>
        </mxCell>

        <!-- ==================== FINOPS COST & ARCHITECTURE SUMMARY SECTION ==================== -->
        <mxCell id="finops_container" value="Well-Architected FinOps Cost Model &amp;amp; Architecture Comparison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontColor=#475569;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="880" width="860" height="260" as="geometry"/>
        </mxCell>

        <!-- Left Card: Itemized Breakdown -->
        <mxCell id="finops_itemized" value="&lt;b style=&quot;font-size: 12px; color: #1E293B;&quot;&gt;Itemized Pay-As-You-Go Monthly Breakdown&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.6; color: #334155;&quot;&gt;&lt;b style=&quot;color: #ED7100;&quot;&gt;⚡ AWS Lambda (3 Handlers):&lt;/b&gt; 256 MB RAM, pay-per-invocation &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$1.00 – $3.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #C925D1;&quot;&gt;🗄️ DynamoDB (3 Tables):&lt;/b&gt; On-Demand R/W + TTL + Streams &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$2.00 – $5.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #8C4FFF;&quot;&gt;🚪 API Gateway v2 (HTTP + WS):&lt;/b&gt; Pay-per-message &amp;amp; connection &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$1.00 – $3.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #E7157B;&quot;&gt;📈 CloudWatch Logs &amp;amp; Metrics:&lt;/b&gt; Execution logs &amp;amp; alarms &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;~$1.00 – $2.00&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #7AA116;&quot;&gt;📦 S3 &amp;amp; CloudFront:&lt;/b&gt; Frontend CDN + Avatar uploads &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;&amp;lt; $0.50&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #CC2264;&quot;&gt;🔐 Cognito &amp;amp; SSM Store:&lt;/b&gt; 50k MAUs free tier + Standard params &amp;bull; &lt;b style=&quot;color: #16A34A;&quot;&gt;$0.00 (Free)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="915" width="450" height="205" as="geometry"/>
        </mxCell>

        <!-- Right Card Top: Total Estimated Cost -->
        <mxCell id="finops_total_card" value="&lt;span style=&quot;font-size: 11px; color: #166534; font-weight: bold; text-transform: uppercase;&quot;&gt;Total Estimated Monthly Cost&lt;/span&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 22px; color: #15803D;&quot;&gt;~$5.00 – $10.00 / mo&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #166534;&quot;&gt;Full Serverless MVP 24/7 (Pay-As-You-Go)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="915" width="350" height="85" as="geometry"/>
        </mxCell>

        <!-- Right Card Bottom: Architecture Savings -->
        <mxCell id="finops_savings_card" value="&lt;b style=&quot;font-size: 12px; color: #92400E;&quot;&gt;💡 Architectural Cost Avoidance&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #78350F;&quot;&gt;Compared to traditional book architecture (VPC + Redis):&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-size: 10px; line-height: 1.5; color: #92400E; text-align: left; padding-left: 5px;&quot;&gt;&amp;bull; &lt;b&gt;No VPC / No NAT Gateway:&lt;/b&gt; Saves &lt;b style=&quot;color: #B45309;&quot;&gt;~$32 – $40 / mo&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;No ElastiCache Redis Cluster:&lt;/b&gt; Saves &lt;b style=&quot;color: #B45309;&quot;&gt;~$13 – $50 / mo&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;color: #15803D; font-size: 11px;&quot;&gt;Total Savings: ~$45.00 – $90.00 / month saved!&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#FCD34D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1010" width="350" height="110" as="geometry"/>
