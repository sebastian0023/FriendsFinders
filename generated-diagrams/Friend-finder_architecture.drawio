        <!-- Terraform Remote State -->
        <mxCell id="icon_tf_state" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;strokeColor=#ffffff;outlineConnect=0;" vertex="1" parent="1">
